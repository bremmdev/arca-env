{
  "name": "@bremmdev/arca-env",
  "version": "0.6.0",
  "description": "Keep secrets out of .env files and out of reach of AI agents. Encrypted local store, injected at runtime, output always masked.",
  "type": "module",
  "license": "MIT",
  "author": "bremmdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/bremmdev/arca-env"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "arca": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "ai-agents",
    "keychain",
    "redaction"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "frameworks": "node scripts/frameworks.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.2",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
